---
title: Comic Archive
layout: false
---
{% extends "base.njk" %}

{% block fulltitle %}{{ site.name }}{% endblock %}

{% block head %}
<meta name="description" content="A webcomic archive powered by MCP (Model Context Protocol). Browse, search, and read comics with AI agent support.">
{% endblock %}

{% block content %}
<section>
  <h1>Welcome to the Comic Archive</h1>
  <p class="intro">This is a demo site showing how to build an MCP-enabled webcomic archive. Comics can be read by humans in the browser, or by AI agents via MCP tools.</p>

  <h2>Featured Comics</h2>
  <ul class="featured-comics group">
    {% for comic in manifest.comics %}
    <li>
      <a href="/comics/">
        <h3>{{ comic.title }}</h3>
        {% if comic.coverImage %}
        <img src="/{{ comic.coverImage }}" alt="{{ comic.title }}" width="210" height="300" />
        {% else %}
        <div class="placeholder-cover">
          <span>{{ comic.title }}</span>
        </div>
        {% endif %}
        <p>{{ comic.storylines.length }} storylines</p>
      </a>
    </li>
    {% endfor %}
  </ul>

  <p class="cta">
    <a href="/comics/" class="button">Browse All Comics</a>
  </p>
</section>

<section>
  <h2>About This Site</h2>
  <p>This site demonstrates the "three surfaces" architecture:</p>
  <ol>
    <li><strong>Static Website</strong> — HTML pages you're reading now</li>
    <li><strong>MCP Server</strong> — AI agents can read comics via structured tools</li>
    <li><strong>WebMCP</strong> — Browser-based agents can interact with this page</li>
  </ol>
  <p><a href="/about/">Learn more about this project</a></p>
</section>
{% endblock %}

{% block sidebar %}
<section class="sidebar">
  <h2>Quick Links</h2>
  <ul>
    <li><a href="/comics/">Comics Archive</a></li>
    <li><a href="/about/">About</a></li>
    <li><a href="/search/">Search</a></li>
  </ul>
</section>
{% endblock %}

{% block extendedFooter %}
{% include "footer-home.njk" %}
{% endblock %}
