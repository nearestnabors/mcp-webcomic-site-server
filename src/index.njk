---
title: Comic Archive
layout: false
---
{% extends "base.njk" %}

{% block fulltitle %}{{ site.name }}{% endblock %}

{% block head %}
<meta name="description" content="A webcomic archive powered by MCP (Model Context Protocol). Browse, search, and read comics with AI agent support.">
{% endblock %}

{% block content %}
<section>
  <h1>Latest Comics</h1>
  <p class="intro">This is a demo site showing how to build an MCP-enabled webcomic archive. Comics can be read by humans in the browser, or by AI agents via MCP tools.</p>

  <ul class="archive-list">
  {% for comic in manifest.comics %}
    {% for storyline in comic.storylines %}
    <li>
      <h2><a href="/comics/{{ storyline.pages[0].slug }}/">{{ storyline.title }}</a></h2>
      {% if storyline.description %}
      <p>{{ storyline.description }}</p>
      {% endif %}
    </li>
    {% endfor %}
  {% endfor %}
  </ul>
</section>

<section class="about-section">
  <h2>About This Site</h2>
  <p>This site demonstrates the "three surfaces" architecture:</p>
  <dl class="features-list">
    <dt>Static Website</dt>
    <dd>HTML pages you're reading now</dd>
    <dt>MCP Server</dt>
    <dd>AI agents can read comics via structured tools</dd>
    <dt>WebMCP</dt>
    <dd>Browser-based agents can interact with this page</dd>
  </dl>
  <p><a href="/about/" class="button">Learn More About This Project</a></p>
</section>
{% endblock %}

{% block sidebar %}
<section class="sidebar">
  <h2>Quick Links</h2>
  <ul>
    <li><a href="/comics/">Comics Archive</a></li>
    <li><a href="/about/">About</a></li>
    <li><a href="/search/">Search</a></li>
  </ul>
</section>
{% endblock %}
