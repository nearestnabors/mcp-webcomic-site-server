<div class="search-container">
  <form action="/search/" method="get" class="search-form"
        toolname="search_comics"
        tooldescription="Search comic transcripts and commentary for matching content. Returns page titles, URLs, and excerpts.">
    <input type="search"
           name="q"
           toolparamdescription="The search query to find in comic transcripts and commentary"
           required
           placeholder="Search..."
           aria-label="Search" />
    <button type="submit" aria-label="Submit search">Search</button>
  </form>
</div>
