<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index, follow, noai, noimageai">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VFKZBELP2D"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-VFKZBELP2D');
  </script>
  <title>{% block fulltitle %}{% block title %}{{ title }}{% endblock %} | {{ site.name }}{% endblock %}</title>
  <link rel="stylesheet" href="/css/styles-min.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/comic-click-nav.css">
  <link rel="stylesheet" href="/css/nav-mobile.css">
  <link rel="stylesheet" href="/css/comic-nav-fix.css">
  <link rel="stylesheet" href="/css/archive-grid.css">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <!-- Open Graph defaults -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <!-- Canonical URL -->
  {% block canonical %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endblock %}
  <!-- Prev/Next Navigation (overridden by layouts) -->
  {% block prevnext %}{% endblock %}
  {% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {% include "header.njk" %}

  <div class="wrapper_content group">
    <main id="content">
      {% block content %}{% endblock %}
    </main>

    {% block sidebar %}{% endblock %}
  </div>

  {% block extendedFooter %}{% endblock %}

  {% include "footer.njk" %}

  <script src="/js/nav-mobile.js" defer></script>
  <script src="/js/transcript-toggle.js" defer></script>
  {% block scripts %}{% endblock %}
  {% block webmcp %}{% include "webmcp-minimal.njk" %}{% endblock %}
</body>
</html>
