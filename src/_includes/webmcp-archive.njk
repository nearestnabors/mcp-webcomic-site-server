{# WebMCP Archive Page - Tools for paginated archive pages
   Tools: list_comics, search_comics (from base)
          + prev_page (if pagination.href.previous exists)
          + next_page (if pagination.href.next exists)

   Required variables: pagination (11ty pagination object)
#}
{% include "webmcp-base.njk" %}

{% if pagination and (pagination.href.previous or pagination.href.next) %}
<script>
(function() {
  'use strict';

  if (!('modelContext' in document)) {
    return;
  }

  {% if pagination.href.previous %}
  // Tool: prev_page (newer content)
  document.modelContext.registerTool({
    name: 'prev_page',
    description: 'Navigate to the previous page of the archive (newer content). This navigates the browser away from the current page.',
    annotations: { readOnlyHint: false },
    inputSchema: {
      type: 'object',
      properties: {},
      required: []
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean' },
        navigating_to: { type: 'string' }
      }
    },
    async execute() {
      window.location.href = {{ pagination.href.previous | dump | safe }};
      const data = { success: true, navigating_to: {{ pagination.href.previous | dump | safe }} };
      return {
        content: [{ type: 'text', text: JSON.stringify(data) }],
        structuredContent: data
      };
    }
  });
  {% endif %}

  {% if pagination.href.next %}
  // Tool: next_page (older content)
  document.modelContext.registerTool({
    name: 'next_page',
    description: 'Navigate to the next page of the archive (older content). This navigates the browser away from the current page.',
    annotations: { readOnlyHint: false },
    inputSchema: {
      type: 'object',
      properties: {},
      required: []
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean' },
        navigating_to: { type: 'string' }
      }
    },
    async execute() {
      window.location.href = {{ pagination.href.next | dump | safe }};
      const data = { success: true, navigating_to: {{ pagination.href.next | dump | safe }} };
      return {
        content: [{ type: 'text', text: JSON.stringify(data) }],
        structuredContent: data
      };
    }
  });
  {% endif %}

  console.log('WebMCP: archive tools registered ({% if pagination.href.previous %}prev_page{% endif %}{% if pagination.href.previous and pagination.href.next %}, {% endif %}{% if pagination.href.next %}next_page{% endif %})');
})();
</script>
{% endif %}
